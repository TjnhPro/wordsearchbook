<Window x:Class="WordSearchBook.Desktop.Shutdown.CloseApplicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Word Search Book"
        Width="460"
        Height="270"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Closing="OnDialogClosing">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="DialogEyebrow"
                 Text="CLOSE APPLICATION"
                 Foreground="#EA580C"
                 FontSize="11"
                 FontWeight="Bold" />
      <TextBlock x:Name="DialogTitle"
                 Margin="0,8,0,0"
                 Text="Background work is still active"
                 Foreground="#0F172A"
                 FontSize="21"
                 FontWeight="Bold" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,18">
      <TextBlock x:Name="ConfirmationMessage"
                 Foreground="#475569"
                 FontSize="14"
                 LineHeight="22"
                 TextWrapping="Wrap" />

      <StackPanel x:Name="ClosingState" Visibility="Collapsed">
        <TextBlock Text="Cancelling background work and finishing up…"
                   Foreground="#475569"
                   FontSize="14"
                   TextWrapping="Wrap" />
        <ProgressBar Margin="0,18,0,0"
                     Height="6"
                     IsIndeterminate="True"
                     Foreground="#EA580C"
                     Background="#FFEDD5" />
        <TextBlock Margin="0,10,0,0"
                   Text="This can take up to 5 seconds."
                   Foreground="#94A3B8"
                   FontSize="12" />
      </StackPanel>
    </Grid>

    <StackPanel x:Name="ConfirmationActions"
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="104"
              Height="36"
              Margin="0,0,10,0"
              Content="Keep open"
              IsCancel="True"
              Click="OnKeepOpenClick"
              Background="White"
              BorderBrush="#CBD5E1"
              Foreground="#334155"
              FontWeight="SemiBold" />
      <Button Width="104"
              Height="36"
              Content="Close app"
              IsDefault="True"
              Click="OnCloseAppClick"
              Background="#EA580C"
              BorderBrush="#EA580C"
              Foreground="White"
              FontWeight="Bold" />
    </StackPanel>
  </Grid>
</Window>
