<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WordSearchBook</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WordSearchBook.Core\WordSearchBook.Core.csproj" />
    <ProjectReference Include="..\WordSearchBook.Infrastructure\WordSearchBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Frontend\index.html;Frontend\css\tailwind.css;Frontend\js\app.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
