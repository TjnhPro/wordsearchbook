<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WordSearchBook</AssemblyName>
    <ApplicationIcon>Assets\wordsearchbook.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WordSearchBook.Core\WordSearchBook.Core.csproj" />
    <ProjectReference Include="..\WordSearchBook.Infrastructure\WordSearchBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\wordsearchbook.ico" />
    <EmbeddedResource Include="Assets\wordsearchbook-icon-1024.png"
                      LogicalName="WordSearchBook.Desktop.Frontend.assets.wordsearchbook-icon-1024.png" />
    <EmbeddedResource Include="Frontend\index.html"
                      LogicalName="WordSearchBook.Desktop.Frontend.index.html" />
    <EmbeddedResource Include="Frontend\css\tailwind.css"
                      LogicalName="WordSearchBook.Desktop.Frontend.css.tailwind.css" />
    <EmbeddedResource Include="Frontend\js\app.js"
                      LogicalName="WordSearchBook.Desktop.Frontend.js.app.js" />
  </ItemGroup>

  <Target Name="RemoveNonRuntimeArtifactsFromSingleFilePublish"
          AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <WebView2Documentation Include="$(PublishDir)Microsoft.Web.WebView2*.xml" />
      <PublishedDebugSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(WebView2Documentation)" />
    <Delete Files="@(PublishedDebugSymbols)" />
  </Target>
</Project>
